# Gmail account used by the contact API to send messages.
EMAIL_USER=your-gmail-address@gmail.com

# Gmail App Password for EMAIL_USER (not the normal account password).
EMAIL_PASS=your-16-character-app-password

# Inbox that receives portfolio contact submissions.
CONTACT_RECIPIENT=your-contact-inbox@example.com

# Optional: increases GitHub API limits and enables GraphQL repository queries.
GITHUB_TOKEN=your-github-token
